{
  "modules": {
    "description": "五大模块独立开关",
    "type": "object",
    "items": {
      "enable_ocg": {
        "description": "启用 OCG 指令组（日文/英文卡池、OCG禁卡表、RoTK饼图）",
        "type": "bool",
        "default": true
      },
      "enable_sc": {
        "description": "启用 简中 指令组（简中禁卡表与环境）",
        "type": "bool",
        "default": true
      },
      "enable_md": {
        "description": "启用 MD 指令组（Master Duel，T表映射为饼图）",
        "type": "bool",
        "default": true
      },
      "enable_dl": {
        "description": "启用 DL 指令组（Duel Links，T表映射为饼图）",
        "type": "bool",
        "default": true
      },
      "enable_ptcg": {
        "description": "启用 PTCG 指令组（宝可梦）",
        "type": "bool",
        "default": true
      }
    }
  },
  "ptcg": {
    "description": "PTCG 数据源设置",
    "type": "object",
    "items": {
      "api_key": {
        "description": "pokemontcg.io 可选 API Key",
        "type": "string",
        "default": ""
      },
      "prefer_source": {
        "description": "PTCG 优先数据源（tcgdex / pokemontcg）",
        "type": "string",
        "default": "tcgdex"
      }
    }
  }
}
