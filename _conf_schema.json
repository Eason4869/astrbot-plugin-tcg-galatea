{
  "modules": {
    "description": "五大模块独立开关",
    "type": "object",
    "items": {
      "enable_ocg": {
        "description": "启用 OCG 指令组（查卡/饼图/禁卡表/随机）",
        "type": "bool",
        "default": true
      },
      "enable_md": {
        "description": "启用 MD 指令组（Master Duel，T表映射为饼图）",
        "type": "bool",
        "default": true
      },
      "enable_dl": {
        "description": "启用 DL 指令组（Duel Links，T表映射为饼图）",
        "type": "bool",
        "default": true
      },
      "enable_ptcg": {
        "description": "启用 PTCG 指令组（宝可梦：查卡/随机）",
        "type": "bool",
        "default": true
      },
      "enable_vg": {
        "description": "启用 VG 指令组（先导者·beta，默认关闭；Fandom 数据源，暂无简中）",
        "type": "bool",
        "default": false
      }
    }
  },
  "ptcg": {
    "description": "PTCG 数据源设置",
    "type": "object",
    "items": {
      "api_key": {
        "description": "pokemontcg.io 可选 API Key",
        "type": "string",
        "default": ""
      },
      "prefer_source": {
        "description": "PTCG 优先数据源（tcgdex / pokemontcg）",
        "type": "string",
        "default": "tcgdex"
      }
    }
  }
}
